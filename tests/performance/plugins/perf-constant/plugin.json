{
  "manifestVersion": 1,
  "id": "perf-constant",
  "mode": "stream",
  "command": ["gjs", "-m", "./run.js"],
  "startupTimeoutMs": 2000,
  "heartbeatTimeoutMs": 2000,
  "maxMessagesPerSecond": 5,
  "maxBytesPerMinute": 65536,
  "position": "right",
  "order": 100,
  "nice": 10,
  "reserveTextChars": 5,
  "passEnvironment": [],
  "failurePolicy": "hide",
  "maxStaleMs": 2000
}
